# SDK 0.3.8 vesting on the reviewed GIWA Sepolia deployment.
AMMORA_CHAIN_ID=91342
AMMORA_GIWA_GENERATION=auto-route
AMMORA_RPC_INTERVAL_MS=600
# Optional: defaults to the public RPC in the SDK catalog.
AMMORA_RPC_URL=
# Preview caller only. Set your funding address for create, recipient for claim.
AMMORA_ACCOUNT=
# No signing is enabled by this template.
AMMORA_SEND=0
AMMORA_PRIVATE_KEY=
# Leave empty for new create/claim plans; historical receipt reads are separate.
AMMORA_READ_RECEIPT=
