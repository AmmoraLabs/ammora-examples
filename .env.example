# Which reviewed Ammora deployment to talk to. The SDK ships the catalog; an id that is
# not in it is refused instead of guessed at.
AMMORA_CHAIN_ID=91342

# GIWA only: legacy (existing examples) or auto-route (SDK reviewed 2026-09-17 generation).
# Config IDs and pool addresses must belong to the selected generation.
AMMORA_GIWA_GENERATION=legacy

# Serialize public reads at this interval; no implicit transport retries. Own providers may use 0.
AMMORA_RPC_INTERVAL_MS=600

# Optional. Defaults to the RPC recorded for the chain in the catalog.
AMMORA_RPC_URL=

# Optional local reviewed pin snapshot for verify/create/swap quickstarts.
# Defaults to runtime-pins.giwa.json beside the copied script.
AMMORA_RUNTIME_PINS_FILE=

# Optional for launch:get-config, launch:preview-config and launch:quote after a new write.
# Prefer a per-command value: this selects that successful canonical receipt's block,
# not the default 12-confirmation snapshot, and does not promise finality/fresh pricing.
AMMORA_READ_RECEIPT=

# Only the examples that send a transaction need this. Read-only examples run without it.
# Use a throwaway key with only what you intend to spend, never a key that holds anything
# you would mind losing.
AMMORA_PRIVATE_KEY=

# Required by EVERY transaction example; read-only commands ignore it.
AMMORA_SEND=0

# Additional explicit opt-in only for launch:graduate.
AMMORA_GRADUATION_CONFIRM=0

# Optional defaults, so you can run an example without passing arguments.
ALMM_POOL=
ARL_POOL=

# Slippage floor for the swap example, in basis points.
AMMORA_SLIPPAGE_BPS=50

# Optional pool activation delay for arl:create-pool (genesis vaults need a future opening).
AMMORA_ACTIVATION_DELAY_MINUTES=0

# New contract-feature actions: caller for RPC plans; no key is needed for previews.
# AMMORA_ACCOUNT=0x...
# Products outside the built-in catalog additionally require the deployment team's
# independently reviewed keccak256 runtime-code pin (not a hash of a fresh RPC read).
# AMMORA_FEATURE_RUNTIME_HASH=0x...64 hex digits...
